#!/usr/bin/env bash
set -euo pipefail

# Must be run from project root
if [[ ! -f "pyproject.toml" && ! -d "src" ]]; then
  echo "Error: run this from the Mirrorcore project root."
  exit 1
fi

# Find next archive name
n=1
while [[ -f "mirrorcore-review${n}.zip" ]]; do
  ((n++))
done
archive="mirrorcore-review${n}.zip"

echo "Cleaning junk before archiving..."

# Remove recursive cache/build junk
find . -type d -name "pycache" -prune -exec rm -rf {} +
find . -type d -name ".pytest_cache" -prune -exec rm -rf {} +
find . -type d -name ".mypy_cache" -prune -exec rm -rf {} +
find . -type d -name ".ruff_cache" -prune -exec rm -rf {} +
find . -type d -name "*.egg-info" -prune -exec rm -rf {} +
find . -type d -name "build" -prune -exec rm -rf {} +
find . -type d -name "dist" -prune -exec rm -rf {} +

# Remove junk files
find . -type f -name "*.pyc" -delete
find . -type f -name "*.pyo" -delete
find . -type f -name "*.backup" -delete
find . -type f -name ".DS_Store" -delete
find . -type f -name "Thumbs.db" -delete

# Remove nested accidental data dir if present
if [[ -d "data/data" ]]; then
  rm -rf "data/data"
fi

echo "Creating archive: ${archive}"

zip -r "$archive" . \
  -x "*/pycache/*" \
     "*/.pytest_cache/*" \
     "*/.mypy_cache/*" \
     "*/.ruff_cache/*" \
     "*/.git/*" \
     "*/.venv/*" \
     "*/build/*" \
     "*/dist/*" \
     "*/.DS_Store" \
     "*/Thumbs.db" \
     "*/mirrorcore.egg-info/*" \
     "*.pyc" \
     "*.pyo" \
     "*.backup" \
     "mirrorcore-review*.zip"

echo "Done: ${archive}"
