{
  "version": "1.0.0",
  "hooks": {
    "pre_commit": [
      {
        "name": "Run tests",
        "command": "python -m pytest tests/",
        "enabled": false
      },
      {
        "name": "Check code style",
        "command": "python -m flake8 src/",
        "enabled": false
      }
    ],
    "pre_push": [
      {
        "name": "Full test suite",
        "command": "python -m pytest tests/ --cov=src/",
        "enabled": false
      }
    ]
  }
}
